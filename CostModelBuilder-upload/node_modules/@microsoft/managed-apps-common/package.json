{
  "name": "@microsoft/managed-apps-common",
  "version": "0.24.0",
  "type": "module",
  "description": "Shared types, utilities, and services for Microsoft Managed Apps packages",
  "license": "MIT",
  "exports": {
    "./config/ms.config.schema.json": "./dist/ms.config.schema.json",
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./communication": {
      "types": "./dist/communication/index.d.ts",
      "default": "./dist/communication/index.js"
    },
    "./dataClient": {
      "types": "./dist/dataClient/index.d.ts",
      "default": "./dist/dataClient/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./telemetry/sensitiveDataScrubber": {
      "types": "./dist/telemetry/sensitiveDataScrubber.d.ts",
      "default": "./dist/telemetry/sensitiveDataScrubber.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./utils/RepoHash": {
      "types": "./dist/utils/RepoHash.d.ts",
      "default": "./dist/utils/RepoHash.js"
    },
    "./vfs": {
      "types": "./dist/vfs/index.d.ts",
      "default": "./dist/vfs/index.js"
    },
    "./testUtils": {
      "types": "./dist/testUtils/index.d.ts",
      "default": "./dist/testUtils/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-esm-fix --target dist && bun scripts/generate-json-schema.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bun test --isolate src/",
    "clean": "bun ../../scripts/clean.ts dist .turbo tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@microsoft/1ds-core-js": "4.3.11",
    "@microsoft/1ds-post-js": "4.3.11"
  },
  "peerDependenciesMeta": {
    "@microsoft/1ds-core-js": {
      "optional": true
    },
    "@microsoft/1ds-post-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/1ds-core-js": "4.3.11",
    "@microsoft/1ds-post-js": "4.3.11",
    "@repo/repo-config": "0.0.0",
    "@types/bun": "1.3.13",
    "tsc-esm-fix": "3.1.2",
    "typescript": "5.9.3"
  }
}
